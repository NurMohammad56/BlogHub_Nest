# ---- Application ----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloghub?schema=public

# ---- Redis (cache + BullMQ দুটোই এটা ব্যবহার করে) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

# ---- JWT ----
# প্রোডাকশনে এগুলো অবশ্যই লম্বা, র‍্যান্ডম স্ট্রিং হতে হবে:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-please
JWT_REFRESH_EXPIRES_IN=7d

# ---- Security ----
BCRYPT_SALT_ROUNDS=12
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
